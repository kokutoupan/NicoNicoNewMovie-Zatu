{
    "manifest_version": 3,
    "name": "ニコニコ動画のフォロー新着を取得する",
    "version": "2.2.1",
    "description": "ニコニコ動画のフォロー新着を取得しポップアップで表示する拡張機能です",
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "permissions": [
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "https://www.nicovideo.jp/*",
        "https://api.feed.nicovideo.jp/*"
    ],
    "content_scripts": [
        {
            "matches": ["https://www.nicovideo.jp/*"],
            "js": ["./src/content.ts"]
        }
    ]
}