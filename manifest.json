{
    "manifest_version": 3,
    "name": "ニコニコ動画のフォロー新着を取得する",
    "version": "2.1.2",
    "description": "ニコニコ動画のフォロー新着を取得しポップアップで表示する拡張機能です",
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "permissions": [
        "storage",
        "tab"
    ],
    "host_permissions": [
        "https://www.nicovideo.jp/*",
        "https://api.feed.nicovideo.jp/*"
    ]
}